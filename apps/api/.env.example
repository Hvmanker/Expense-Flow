# Express API & Gateway Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Storage & Database URIs
MONGODB_URI=mongodb://localhost:27017/expenseflow
REDIS_URL=redis://localhost:6379

# Security & Cryptography Keys
# ENCRYPTION_KEY must be a 32-byte hex string (64 characters) for AES-256-GCM
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=supersecret_jwt_access_key_change_in_production_32bytes
JWT_REFRESH_SECRET=supersecret_jwt_refresh_key_change_in_production

# Local Ollama AI Host
OLLAMA_HOST=http://localhost:11434
