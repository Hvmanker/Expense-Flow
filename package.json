{
  "name": "expenseflow-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 15",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.5",
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "compression": "1.8.2",
      "fast-xml-parser": "5.7.0",
      "joi": "17.13.8",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "shell-quote": "1.11.0",
      "source-map-js": "1.2.2"
    }
  }
}
